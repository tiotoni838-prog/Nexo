# Copia este archivo como ".env" y rellena los valores.
# NUNCA subas el .env real a GitHub.

# Token del bot de Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# IA para detectar los mejores momentos (cualquier API compatible con OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Whisper para transcribir (tiny/base/small/medium — small recomendado)
WHISPER_MODEL=small

# Máximo de clips por comando
MAX_CLIPS=5

# Carpeta temporal de trabajo (opcional)
CLIPBOT_WORKDIR=
