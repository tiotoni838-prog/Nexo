<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajustes"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text" />

    <EditText
        android:id="@+id/fieldEndpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:inputType="textUri"
        android:hint="URL de la API (https://api.openai.com/v1)"
        android:textSize="14sp"
        android:textColor="@color/text" />

    <EditText
        android:id="@+id/fieldModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:inputType="text"
        android:hint="Modelo (gpt-4o-mini)"
        android:textSize="14sp"
        android:textColor="@color/text" />

    <EditText
        android:id="@+id/fieldApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:inputType="textPassword"
        android:hint="API key"
        android:textSize="14sp"
        android:textColor="@color/text" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:text="GUARDAR"
        android:textStyle="bold"
        android:textColor="@color/text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="12sp"
        android:textColor="@color/text_dim"
        android:text="Funciona con cualquier API compatible con OpenAI: OpenAI, Mistral, Groq, DeepSeek, servidores locales…" />
</LinearLayout>
